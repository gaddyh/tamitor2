# TamiTor environment configuration.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# PostgreSQL — used by the persistence layer (SQLAlchemy 2 async + psycopg3).
# Same URL form for sync (Alembic) and async (app): do not strip `+psycopg`.
DATABASE_URL=

# Symmetric key for encrypting provider credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste the 44-char url-safe base64 string below. Required in non-test environments.
TAMITOR_CREDENTIAL_KEY=

# Default region for phone-number normalization (E.164). ISO 3166-1 alpha-2.
# Used when a phone number lacks an explicit country code.
TAMITOR_DEFAULT_PHONE_REGION=IL

# 360dialog — business-owned WhatsApp number transport.
# D360_API_KEY is a per-phone-number key from the 360dialog dashboard.
# D360_WEBHOOK_SECRET must match the provider's supported webhook authentication
# configuration; do not infer tenant identity from customer message content.
D360_API_KEY=
D360_WEBHOOK_SECRET=

# OpenAI — configured when interpretation is enabled.
OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-4.1
